
<table cellpadding="0" cellspacing="0" border="0" 
style="
  width: 100%;  
  max-width: 630px;
  margin: auto;
  background-image: url(https://firebasestorage.googleapis.com/v0/b/hekaapp-23c89.appspot.com/o/00%2FVector%201.png?alt=media&token=fddb4504-53f1-4d9e-8d20-cf16927034d2);
  background-repeat: no-repeat;
  padding: 1rem;
  font-family: 'Rethink Sans', sans-serif;
"
>
  <tr>
    <td
    style="text-align: end;"
    ><img src="https://firebasestorage.googleapis.com/v0/b/hekaapp-23c89.appspot.com/o/00%2FLogo.png?alt=media&token=70cfb020-262f-4e49-b68b-b539c2283096"></td>
  </tr>
  <tr>
    <td
    style="text-align: center;"
    >
      <img src="https://firebasestorage.googleapis.com/v0/b/hekaapp-23c89.appspot.com/o/00%2Fboy-dynamic-color.png?alt=media&token=060d9179-aa66-4c40-baf3-5853f64f6470">
    </td>
  </tr>
  <tr>
    <td
    style="text-align: center;"
    >
      <p style="
        font-size: 24px;
        font-weight: 700;
        line-height: 32px;
        text-aligin: center;
      ">
        Cambio de información: {{ name }}
      </p>
    </td>
  </tr>
  <tr>
    <td
    style="text-align: center;"
    >
      <p style="
        font-size: 24px;
        font-weight: 700;
        line-height: 32px;
        text-aligin: center;
      ">
        Usuario: {{ user }}
      </p>
    </td>
  </tr>
  {{#if data.length }}
    {{#each data }}
      <tr>
        <td>
          <p style="
            font-size: 16px;
            font-weight: 400;
            line-height: 20px;
            text-align: center;
            display: inline-block;
          ">
            {{this.key}}:
          </p>
          <p style="
            font-size: 16px;
            font-weight: 400;
            line-height: 20px;
            text-align: center;
            display: inline-block;
          ">
            {{this.value}}
          </p>
        </td>
      </tr>
  {{/each}}
  {{/if}}
  
</table>